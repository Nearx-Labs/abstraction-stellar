{
  "name": "abstraction-back",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate-cli.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "fixture": "tsx src/email/fixture.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "app:create": "tsx scripts/create-app.ts",
    "check-sdk": "tsx scripts/check-sdk.ts",
    "panel:user": "tsx scripts/panel-user.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@stellar/stellar-sdk": "16.0.1",
    "hono": "^4.6.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "smart-account-kit": "^0.4.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.8"
  }
}
