# Copie para .env e ajuste. Em NODE_ENV=development tudo tem default seguro:
# as chaves de serviço são derivadas de forma determinística e financiadas no
# friendbot no boot, e o app "demo" já vem com pk_test_dev / sk_test_dev.
#
# Fora de development, o processo NÃO SOBE sem os segredos abaixo — é
# proposital: os defaults antigos (fee payer efêmero do friendbot, chave de
# emissor igual à do fixture de teste) eram armadilhas silenciosas.

NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgres://abstraction:abstraction@localhost:5434/abstraction

# ── Rede ──────────────────────────────────────────────────────────────────────
# Fora de development, rede e contratos são OBRIGATÓRIOS e explícitos: os
# defaults do código são os deploys de testnet deste repo, e um default
# silencioso foi como hml e prod acabaram gravando nos mesmos contratos. No
# boot o processo confere no próprio RPC a rede e a existência de cada contrato.
RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
PUBLIC_URL=http://localhost:8080

# ── Contratos ─────────────────────────────────────────────────────────────────
# Saem de scripts/deploy-contracts.sh, que imprime estas linhas.
TREASURY_CONTRACT_ID=CDKC5JHDED55KNI7U7AEJMZN6NLOYIASUWXPAV2QE74SMZ4VEFM7NKOV
XLM_SAC_ADDRESS=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
DEMO_LEDGER_CONTRACT_ID=
ANCHOR_CONTRACT_ID=
MINT_QUOTA_POLICY_ADDRESS=
ED25519_VERIFIER_ADDRESS=
ACCOUNT_WASM_HASH=

# ── Superfície exposta ────────────────────────────────────────────────────────
# Fora de development todas começam desligadas; ligue só o que o ambiente usa.
# O MintVRS opera só com secret key e não precisa de nenhuma.
#   RELAY_ENABLED              relay patrocinado (smart-account-kit no browser)
#   FAUCET_ENABLED             faucet de XLM — nunca liga fora da testnet
#   ACCOUNT_SELF_REGISTRATION  POST /v1/accounts com publishable key
#   PANEL_MASTER_ADMIN         sessão de painel nomeia a mestre (auto-custódia)
#   BOOTSTRAP_ALLOW_DEPLOY     deploy de conta patrocinado pelo relay
RELAY_ENABLED=
FAUCET_ENABLED=
ACCOUNT_SELF_REGISTRATION=
PANEL_MASTER_ADMIN=
BOOTSTRAP_ALLOW_DEPLOY=

# Teto de fee de cada transação assinada pela conta mestre (stroops). Acima
# disso a chamada falha com FEE_CAP em vez de pagar — tipicamente é restauração
# de estado arquivado.
MASTER_MAX_FEE_STROOPS=50000000
# Quanto as rotas da conta mestre esperam por um channel livre (ms).
CHANNEL_WAIT_MS=20000

# ── Chaves por papel (obrigatórias fora de development) ───────────────────────
# channel* pagam as transações dos usuários (o pool resolve a corrida de
# sequence number); operator assina Treasury.consume; owner assina
# set_allowance e allow_target, que são only_owner, e é o REGISTRAR dos
# ledgers (habilita a conta mestre em set_minter/set_writer no provisionamento);
# faucet envia XLM e só é exigido com FAUCET_ENABLED.
#
# O PRIMEIRO channel é o deployer fixo da conta mestre: o endereço dela é
# derivado dele. Não reordene nem troque o primeiro depois de provisionar.
CHANNEL_SECRETS=
TREASURY_OPERATOR_SECRET=
TREASURY_OWNER_SECRET=
FAUCET_SECRET=

# ── Faucet ────────────────────────────────────────────────────────────────────
FAUCET_AMOUNT_STROOPS=100000000
FAUCET_COOLDOWN_HOURS=24
# Calibrado pelo custo real: criar uma context rule com policy e assinatura
# WebAuthn custa ~1,02 XLM no testnet. Tetos menores recusam a operação mais
# comum do produto.
ALLOWANCE_MAX_PER_TX=30000000
ALLOWANCE_MAX_PER_DAY=200000000

# ── Conta mestre por tenant ───────────────────────────────────────────────────
# A chave Ed25519 com que o serviço assina como conta mestre é DERIVADA daqui
# mais o id do app — nenhum segredo fica em repouso no banco. Trocar este valor
# invalida os grants já concedidos on-chain (a chave muda, a regra não).
MASTER_SIGNER_SEED=

# ── WebAuthn (sessão do painel) ───────────────────────────────────────────────
RP_ID=localhost
RP_ORIGINS=http://localhost:5173

# ── Emissor de email (Fase 2; sem UI) ─────────────────────────────────────────
# Trocar SUBJECT_SALT depois invalida TODO email signer já registrado on-chain.
ISSUER_SEED_HEX=
SUBJECT_SALT=abstraction-dev-salt

# ── Front ─────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8080
VITE_PUBLISHABLE_KEY=pk_test_dev

# Login do painel criado no boot, quando a conta mestre já existe.
BOOTSTRAP_PANEL_EMAIL=
BOOTSTRAP_PANEL_PASSWORD=
