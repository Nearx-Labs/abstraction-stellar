# Copie para .env e ajuste. Em NODE_ENV=development tudo tem default seguro:
# as chaves de serviço são derivadas de forma determinística e financiadas no
# friendbot no boot, e o app "demo" já vem com pk_test_dev / sk_test_dev.
#
# Fora de development, o processo NÃO SOBE sem os segredos abaixo — é
# proposital: os defaults antigos (fee payer efêmero do friendbot, chave de
# emissor igual à do fixture de teste) eram armadilhas silenciosas.

NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgres://abstraction:abstraction@localhost:5434/abstraction

# ── Rede ──────────────────────────────────────────────────────────────────────
RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ── Contratos (testnet, deploys deste repositório) ────────────────────────────
TREASURY_CONTRACT_ID=CDKC5JHDED55KNI7U7AEJMZN6NLOYIASUWXPAV2QE74SMZ4VEFM7NKOV
XLM_SAC_ADDRESS=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# ── Chaves por papel (obrigatórias fora de development) ───────────────────────
# channel* pagam as transações dos usuários (o pool resolve a corrida de
# sequence number); operator assina Treasury.consume; owner assina
# set_allowance e allow_target, que são only_owner; faucet envia XLM.
CHANNEL_SECRETS=
TREASURY_OPERATOR_SECRET=
TREASURY_OWNER_SECRET=
FAUCET_SECRET=

# ── Faucet ────────────────────────────────────────────────────────────────────
FAUCET_AMOUNT_STROOPS=100000000
FAUCET_COOLDOWN_HOURS=24
ALLOWANCE_MAX_PER_TX=5000000
ALLOWANCE_MAX_PER_DAY=20000000

# ── Conta mestre por tenant ───────────────────────────────────────────────────
# A chave Ed25519 com que o serviço assina como conta mestre é DERIVADA daqui
# mais o id do app — nenhum segredo fica em repouso no banco. Trocar este valor
# invalida os grants já concedidos on-chain (a chave muda, a regra não).
MASTER_SIGNER_SEED=

# ── WebAuthn (sessão do painel) ───────────────────────────────────────────────
RP_ID=localhost
RP_ORIGINS=http://localhost:5173

# ── Emissor de email (Fase 2; sem UI) ─────────────────────────────────────────
# Trocar SUBJECT_SALT depois invalida TODO email signer já registrado on-chain.
ISSUER_SEED_HEX=
SUBJECT_SALT=abstraction-dev-salt

# ── Front ─────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8080
VITE_PUBLISHABLE_KEY=pk_test_dev
